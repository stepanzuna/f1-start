{
  // Cmd+Shift+B: spustí experiment v aplikaci Terminál (okno PsychoPy pak není schované za VS Code).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Spustit experiment (Terminál)",
      "type": "shell",
      "osx": {
        "command": "osascript",
        "args": [
          "-e",
          "tell application \"Terminal\" to do script \"cd '${workspaceFolder}' && uv run main.py\"",
          "-e",
          "tell application \"Terminal\" to activate"
        ]
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      // Cmd+Shift+P → Tasks: Run Task → tato úloha. Zkrácený plán (12 startů), nick musí začínat „test“.
      "label": "Zkrácený test (Terminál, --short)",
      "type": "shell",
      "osx": {
        "command": "osascript",
        "args": [
          "-e",
          "tell application \"Terminal\" to do script \"cd '${workspaceFolder}' && uv run main.py --short\"",
          "-e",
          "tell application \"Terminal\" to activate"
        ]
      },
      "group": "build",
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    }
  ]
}
